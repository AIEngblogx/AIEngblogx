  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "smol-toml": "^1.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
