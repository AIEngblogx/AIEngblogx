{
  "name": "blog-translate",
  "version": "0.1.0",
  "type": "module",
  "description": "Crawl public engineering blogs and translate them into any language",
  "bin": {
    "blog-translate": "dist/main.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test \"tests/*.test.ts\"",
